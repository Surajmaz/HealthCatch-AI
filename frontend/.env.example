VITE_API_URL=http://127.0.0.1:8000

# Firebase config — copy these from Firebase Console > Project Settings >
# General > Your apps > SDK setup and configuration. Safe to be visible in
# the browser (see firebase.js) — real protection is Authorized Domains +
# API key restrictions in your Firebase/Google Cloud consoles.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
